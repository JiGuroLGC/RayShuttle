<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RayShuttle.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- 列比与背景图一致（1.37076 : 1），内容落在图片左侧，不与之重叠 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.37076*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="{StaticResource OnboardingPadding}">
            <!-- 与协议页完全一致：垂直居中 + 同一限宽 600。
                 用 Stretch 而非 Left：Left 会让 StackPanel 退化为按内容取宽，
                 而无 MaxLength 的邀请码 PasswordBox 又会把宽度撑大，于是卡片随输入不断变长。
                 Stretch 让内容块始终填满列宽并受 MaxWidth=600 收住，输入框也恒定占满 600，
                 不随输入增长。 -->
            <StackPanel x:Name="ContentBlock"
                        MaxWidth="600"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="16">

                <StackPanel x:Name="HeaderBlock" Spacing="8">
                    <TextBlock Style="{StaticResource TextTitle}" Text="接入光梭" />
                    <TextBlock Style="{StaticResource TextBody}" Text="凭光而行，自此启程。" />
                </StackPanel>

                <Border Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TextOverline}" Text="用户名" />
                            <TextBox x:Name="UserNameBox"
                                     KeyDown="OnFieldKeyDown"
                                     MaxLength="10"
                                     PlaceholderText="2–10 位字母、数字或下划线" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TextOverline}" Text="邀请码" />
                            <PasswordBox x:Name="InviteCodeBox"
                                         KeyDown="OnFieldKeyDown"
                                         PasswordRevealMode="Peek"
                                         PlaceholderText="32 位数字或大写字母" />
                        </StackPanel>

                        <TextBlock x:Name="ErrorText"
                                   Foreground="{StaticResource StatusBadBrush}"
                                   Style="{StaticResource TextCaption}"
                                   Visibility="Collapsed" />

                        <Button x:Name="SignInButton"
                                HorizontalAlignment="Left"
                                Click="OnSignInClicked"
                                Style="{StaticResource BrandButton}">
                            <TextBlock Text="进入光梭" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
