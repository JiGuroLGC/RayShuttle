<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RayShuttle.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- 不要写 HorizontalAlignment="Left"：那会让 Grid 按「自身期望宽度」排列而不是可用宽度，
         内含 ScrollViewer / 可换行文本时期望宽度可能很小，Grid 会塌缩成窄块。 -->
    <Grid Padding="{StaticResource PagePadding}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <StackPanel x:Name="HeaderBlock" Spacing="8">
                    <TextBlock Style="{StaticResource TextTitle}" Text="设置" />
                    <TextBlock Style="{StaticResource TextBody}" Text="调校你的光路。以下选项目前仅呈现界面，尚未接入实际逻辑。" />
                </StackPanel>

                <!--#region 账户 -->
                <Border x:Name="AccountCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource TextOverline}" Text="账户" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="用户名" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="当前登录的账号" />
                            </StackPanel>
                            <TextBlock x:Name="AccountNameText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextRowTitle}"
                                       Text="--" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="邀请码" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="只保留末 4 位，明文不会落盘" />
                            </StackPanel>
                            <TextBlock x:Name="InviteCodeText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="--" />
                        </Grid>

                        <Button Click="OnSignOutClicked" Style="{StaticResource GhostButton}">
                            <TextBlock Text="退出登录" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region 节点 -->
                <Border x:Name="NodeCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource TextOverline}" Text="节点" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="节点源优先级" />
                                <TextBlock x:Name="NodeSourceHintText" Style="{StaticResource TextCaption}" />
                            </StackPanel>
                            <ComboBox x:Name="NodeSourceBox"
                                      Grid.Column="1"
                                      MinWidth="240"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnNodeSourceChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region 连接 -->
                <Border x:Name="ConnectionCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource TextOverline}" Text="连接" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="启动时自动连接" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="打开光梭后立即接入上次使用的节点" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="断线自动重连" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="隧道意外中断时自动恢复连接" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="True"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="网络中断保护" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="隧道断开期间阻断全部流量，避免真实地址泄露" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="True"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="分流模式" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="决定哪些流量经过加密隧道" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="164"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="智能分流" />
                                <ComboBoxItem Content="全局代理" />
                                <ComboBoxItem Content="仅指定应用" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region 通用 -->
                <Border x:Name="GeneralCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource TextOverline}" Text="通用" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="开机自启" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="随系统登录静默启动光梭" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="关闭窗口时最小化到托盘" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="保持后台连接不中断" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="True"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region 高级 -->
                <Border x:Name="AdvancedCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource TextOverline}" Text="高级" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="传输协议" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="WireGuard 速度最快，OpenVPN 兼容性最好" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="164"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="WireGuard" />
                                <ComboBoxItem Content="OpenVPN" />
                                <ComboBoxItem Content="IKEv2" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TextRowTitle}" Text="局域网直连" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="允许访问同一局域网内的设备" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="True"
                                          OffContent=""
                                          OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!--#endregion-->

                <!--#region 关于 -->
                <Border x:Name="AboutCard" Style="{StaticResource CardSurface}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource TextOverline}" Text="关于" />

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Grid Width="28" Height="28">
                                <Ellipse Fill="{StaticResource BrandGradientDiagonalBrush}" />
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="#FF050A14"
                                         Opacity="0.6" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextSubtitle}"
                                       Text="光梭 RayShuttle" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource TextBody}" Text="隐于光，行无界。" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="版本 0.1.0 · 界面预览版" />
                    </StackPanel>
                </Border>
                <!--#endregion-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
