<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RayShuttle.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:RayShuttle.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RayShuttle.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <common:BrushKeyConverter x:Key="BrushKey" />

        <!-- IsSourceGrouped 让 ListView 直接使用 ServerGroup 的 Key 作为分组标题 -->
        <CollectionViewSource x:Name="GroupedNodes" IsSourceGrouped="True" />

        <!-- 分组标题用 {Binding}：GroupStyle 的 HeaderTemplate 数据上下文是分组对象本身，
             {Binding} 在上下文不符时只会留空，比 {x:Bind} 的强转更安全 -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <StackPanel Margin="4,20,0,6" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource TextSubtitle}"
                           Text="{Binding Key}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="{Binding CountText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NodeItemTemplate" x:DataType="models:ProxyNode">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="34" Height="34">
                    <Ellipse Fill="{StaticResource BrandGradientDiagonalBrush}" Opacity="0.9" />
                    <Ellipse Width="10"
                             Height="10"
                             Fill="#FF050A14"
                             Opacity="0.65" />
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{x:Bind Name}" />
                        <Border Padding="8,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource PillSurface}"
                                Visibility="{x:Bind IsRecommended, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource BrandCyanBrush}"
                                       Text="推荐" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" Text="{x:Bind Subtitle}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="11,5"
                        VerticalAlignment="Center"
                        Style="{StaticResource PillSurface}">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind LatencyColorKey, Converter={StaticResource BrushKey}}"
                               Text="{x:Bind LatencyText}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 不要写 HorizontalAlignment="Left"：那会让 Grid 按「自身期望宽度」排列而不是可用宽度，
         内含 ScrollViewer / 可换行文本时期望宽度可能很小，Grid 会塌缩成窄块。 -->
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region 标题与筛选 -->
        <Grid x:Name="HeaderBlock" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top" Spacing="8">
                <TextBlock Style="{StaticResource TextTitle}" Text="节点" />
                <TextBlock Style="{StaticResource TextBody}" Text="就近接入延迟最低的节点，光路更短，速度更稳。" />
                <!-- 节点文件来自哪里、加载成功与否，直接说明，避免用户对着演示节点困惑 -->
                <TextBlock x:Name="SourceStatusText" Style="{StaticResource TextCaption}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="10">
                <TextBox x:Name="SearchBox"
                         Width="204"
                         PlaceholderText="搜索城市或地区"
                         TextChanged="OnSearchTextChanged" />
                <Button Click="OnBestNodeClicked" Style="{StaticResource BrandButton}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="12" Glyph="&#xE945;" />
                        <TextBlock Text="智能优选" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <ListView x:Name="NodeList"
                  Grid.Row="1"
                  Margin="0,6,0,0"
                  Background="Transparent"
                  ItemContainerStyle="{StaticResource NodeItemStyle}"
                  ItemTemplate="{StaticResource NodeItemTemplate}"
                  ItemsSource="{Binding Source={StaticResource GroupedNodes}}"
                  SelectionChanged="OnNodeSelectionChanged"
                  SelectionMode="Single">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
            </ListView.GroupStyle>
        </ListView>
    </Grid>
</Page>
