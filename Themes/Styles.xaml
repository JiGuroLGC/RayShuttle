<?xml version="1.0" encoding="utf-8"?>
<!--
    光梭 RayShuttle —— 文字尺度、卡片与按钮样式。

    字号约定（自上而下）：
      页面标题 24 / 区块标题 16 / 正文 14 / 注释 12 / 字段标签 11 / 数值 20。
    中文正文额外设置了行高，避免多行文字挤在一起。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region 文字样式 -->
    <!--
        不要设 TextLineBounds="Tight"：它会把行盒裁到「紧贴文字轮廓」，而中文回退字体
        （雅黑等）的字形会超出西文字体的 tight 边界，于是字形顶部溢出行盒；一旦标题落在
        会裁剪的容器里（如设置页的 ScrollViewer），顶部就会被切掉。用默认的 Full 行车盒最稳。
    -->
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 小号标签，用于卡片与之上的字段名 -->
    <Style x:Key="TextOverline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- 数值展示 -->
    <Style x:Key="TextMetric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <!-- 屏幕比设计下限还小时（小屏高 DPI）会挤压到这一档，省略号比直接截断体面 -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 设置项标题 -->
    <Style x:Key="TextRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <!--#endregion-->

    <!--#region 卡片 -->
    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="PillSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <!--#endregion-->

    <!--#region 按钮 -->
    <!-- 主按钮：品牌渐变填充 -->
    <Style x:Key="BrandButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF04121E" />
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RootScale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 悬停时浮起的高光 -->
                        <Border x:Name="Sheen"
                                Background="{StaticResource TopSheenBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.18" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次级按钮：玻璃质感 -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RootScale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                                                       Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="#804FE3FF" />
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        菜单项：给托盘右键菜单用。无边框、整行可点，悬停/按下只叠一层淡高光
        （不用 GhostButton —— 那是有底色有描边的次级按钮，放在菜单里太重）。
    -->
    <Style x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="Transparent"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Fill"
                                Background="{StaticResource SidebarHoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.7" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 列表项 -->
    <!-- 覆盖主题资源即可获得品牌化的悬停与选中效果，无需替换 ListViewItem 模板 -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1F4FE3FF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2E4FE3FF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3D4FE3FF" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />

    <!--
        节点列表项。**自带模板**：默认的 ListViewItem 模板不会把悬停 / 选中底色画成圆角
        （只设 CornerRadius 没用），所以这里用一个圆角 Border 承接高亮，
        观感与托盘右键菜单一致。

        状态名（Normal / PointerOver / Pressed / Selected / PointerOverSelected / PressedSelected）
        是 ListViewItem 内部 GoToState 时用的**固定名字**，不能改，改了高亮就不出现。
    -->
    <Style x:Key="NodeItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Highlight"
                                Background="Transparent"
                                CornerRadius="12" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundSelected}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!-- 下面这几个是框架可能用到的状态名。缺一个不会报错，
                                     但 GoToState 会失败并停在旧状态（高亮卡住），所以宁可都列上。 -->
                                <VisualState x:Name="PointerOverPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverPressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MultiSelectStates">
                                <VisualState x:Name="MultiSelectDisabled" />
                                <VisualState x:Name="MultiSelectEnabled" />
                                <VisualState x:Name="MultiSelectEnabledWithSelection" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ReorderingStates">
                                <VisualState x:Name="NotReordering" />
                                <VisualState x:Name="Reordering" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 链接 -->
    <!-- 覆盖主题资源即可把 HyperlinkButton 变成品牌青的细链接，不必替换模板 -->
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource BrandCyanColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource BrandCyanColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource BrandCyanColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="#1F4FE3FF" />
    <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="#334FE3FF" />
    <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="Transparent" />

    <Style x:Key="LinkButton" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{StaticResource BrandCyanBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>
    <!--#endregion-->

    <!--#region 输入与下拉 -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#804FE3FF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextTertiaryColor}" />
    <!--#endregion-->

</ResourceDictionary>
