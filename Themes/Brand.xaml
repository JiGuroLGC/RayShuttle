<?xml version="1.0" encoding="utf-8"?>
<!--
    光梭 RayShuttle —— 品牌设计令牌
    颜色 / 画笔 / 圆角 / 间距。改品牌视觉只需改这一处。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region 品牌色板 -->
    <Color x:Key="BrandCyanColor">#FF4FE3FF</Color>
    <Color x:Key="BrandSkyColor">#FF3FA9F5</Color>
    <Color x:Key="BrandIndigoColor">#FF6C7BFF</Color>
    <Color x:Key="BrandVioletColor">#FFA855F7</Color>

    <!-- 背景层次：由深到浅。
         取值刻意贴近首页背景图的实测底色 #01030A（见「首页背景图」区），
         让图片与窗口背景在交界处几乎无色差。 -->
    <Color x:Key="BaseDeepColor">#FF02040B</Color>
    <Color x:Key="BaseNightColor">#FF01030A</Color>
    <Color x:Key="BaseSlateColor">#FF03060E</Color>

    <!-- 文字层次 -->
    <Color x:Key="TextPrimaryColor">#FFF2F6FF</Color>
    <Color x:Key="TextSecondaryColor">#FFA9B6D0</Color>
    <Color x:Key="TextTertiaryColor">#FF6C7A99</Color>

    <!-- 状态色 -->
    <Color x:Key="StatusOkColor">#FF45F0C8</Color>
    <Color x:Key="StatusWarnColor">#FFFFC46B</Color>
    <Color x:Key="StatusBadColor">#FFFF6B81</Color>
    <!--#endregion-->

    <!--#region 基础画笔 -->
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyanColor}" />
    <SolidColorBrush x:Key="BrandIndigoBrush" Color="{StaticResource BrandIndigoColor}" />
    <SolidColorBrush x:Key="BrandVioletBrush" Color="{StaticResource BrandVioletColor}" />

    <!-- 曲线面积填充用的低透明度同色笔刷（统计页 Sparkline 填充）。 -->
    <SolidColorBrush x:Key="BrandCyanSoftBrush" Color="{StaticResource BrandCyanColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="BrandVioletSoftBrush" Color="{StaticResource BrandVioletColor}" Opacity="0.16" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource StatusOkColor}" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="{StaticResource StatusWarnColor}" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="{StaticResource StatusBadColor}" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#18FFFFFF" />

    <!-- 悬浮侧栏 -->
    <SolidColorBrush x:Key="SidebarIndicatorBrush" Color="#2E4FE3FF" />
    <SolidColorBrush x:Key="SidebarIndicatorBorderBrush" Color="#7A4FE3FF" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SidebarShadowBrush" Color="#59000000" />
    <!--#endregion-->

    <!--#region 品牌渐变 -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BrandCyanColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandIndigoColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource BrandVioletColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradientDiagonalBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandCyanColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandVioletColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片描边：左上偏青、右下偏紫，形成极细的「光边」 -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4D4FE3FF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.45" />
        <GradientStop Color="#33A855F7" Offset="1" />
    </LinearGradientBrush>

    <!-- 顶部高光，用于卡片内衬一道光 -->
    <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!--#endregion-->

    <!--#region 背景与氛围光 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BaseDeepColor}" Offset="0" />
        <GradientStop Color="{StaticResource BaseNightColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource BaseSlateColor}" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AuroraCyanBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4D4FE3FF" Offset="0" />
        <GradientStop Color="#1A4FE3FF" Offset="0.45" />
        <GradientStop Color="#004FE3FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4DA855F7" Offset="0" />
        <GradientStop Color="#1AA855F7" Offset="0.45" />
        <GradientStop Color="#00A855F7" Offset="1" />
    </RadialGradientBrush>
    <!--#endregion-->

    <!--#region 首页背景图 -->
    <!--
        实测该图：整体不透明，最暗 25% 像素（即图片自身的黑底）平均色 #01030A。
        AppBackgroundBrush 已按这个值收敛，所以交界处几乎没有色差。

        图片铺满整个窗口高度并贴住上/右/下三边，只有左边与背景相接，
        因此只需要一条「左边溶解」。溶解色直接取 #01030A（图片底色 = 背景色），
        两端颜色一致，不会露出接缝。需要调节奏时只改下面的 Offset。
    -->
    <!-- 左边溶解：左端为不透明底色，向右渐隐 -->
    <LinearGradientBrush x:Key="BackdropLeftFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF01030A" Offset="0" />
        <GradientStop Color="#D901030A" Offset="0.06" />
        <GradientStop Color="#7301030A" Offset="0.18" />
        <GradientStop Color="#0001030A" Offset="0.34" />
    </LinearGradientBrush>

    <!-- 压暗蒙版：左侧压得重一些（UI 主要叠在图片左侧），向右逐渐减弱 -->
    <LinearGradientBrush x:Key="BackdropScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4D01030A" Offset="0" />
        <GradientStop Color="#1F01030A" Offset="0.5" />
        <GradientStop Color="#0A01030A" Offset="1" />
    </LinearGradientBrush>
    <!--#endregion-->

    <!--#region 玻璃卡片 -->
    <AcrylicBrush x:Key="GlassCardBrush"
                  TintColor="#FF0B1220"
                  TintOpacity="0.30"
                  TintLuminosityOpacity="0.42"
                  FallbackColor="#FF101A2C" />

    <AcrylicBrush x:Key="GlassCardHoverBrush"
                  TintColor="#FF122040"
                  TintOpacity="0.35"
                  TintLuminosityOpacity="0.55"
                  FallbackColor="#FF17233A" />

    <AcrylicBrush x:Key="PillBrush"
                  TintColor="#FF0D1626"
                  TintOpacity="0.25"
                  TintLuminosityOpacity="0.38"
                  FallbackColor="#FF131E30" />

    <!--
        独立弹窗（托盘右键菜单）专用的**实色**底与描边。
        **弹窗里不能用上面的玻璃(亚克力)笔刷**：那些窗口没有 Mica/Acrylic 宿主背景，
        亚克力会去混窗口的宿主底色，浅色主题下整块发白——托盘菜单那圈白边就是这么来的。
        描边也刻意用品牌青而不是 HairlineBrush，免得看着像一道白线。
    -->
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FF101A2C" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#3D4FE3FF" />

    <!-- 信息提示块的底色（分流页面的 geo 提示等）。低饱和的青，浮在卡片之上不刺眼。 -->
    <SolidColorBrush x:Key="InfoBrush" Color="#18283A" />
    <!--#endregion-->

    <!--#region 连接光球 -->
    <!-- 待机：冷灰蓝 -->
    <SolidColorBrush x:Key="OrbIdleStrokeBrush" Color="#55688C" />

    <RadialGradientBrush x:Key="OrbIdleCoreBrush" Center="0.5,0.42" GradientOrigin="0.5,0.38" RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#FF243352" Offset="0" />
        <GradientStop Color="#FF141C2E" Offset="0.7" />
        <GradientStop Color="#FF0B1020" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="OrbIdleGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#33688CBE" Offset="0" />
        <GradientStop Color="#00688CBE" Offset="1" />
    </RadialGradientBrush>

    <!-- 激活：品牌青 -->
    <LinearGradientBrush x:Key="OrbActiveRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#004FE3FF" Offset="0" />
        <GradientStop Color="#FF4FE3FF" Offset="0.35" />
        <GradientStop Color="#FFA855F7" Offset="0.7" />
        <GradientStop Color="#004FE3FF" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="OrbActiveCoreBrush" Center="0.5,0.42" GradientOrigin="0.5,0.36" RadiusX="0.66" RadiusY="0.66">
        <GradientStop Color="#FF1D4A66" Offset="0" />
        <GradientStop Color="#FF122B4A" Offset="0.62" />
        <GradientStop Color="#FF0A1430" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="OrbActiveGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#664FE3FF" Offset="0" />
        <GradientStop Color="#1F4FE3FF" Offset="0.5" />
        <GradientStop Color="#004FE3FF" Offset="1" />
    </RadialGradientBrush>

    <!-- 已连接：青 + 紫罗兰，更亮 -->
    <RadialGradientBrush x:Key="OrbConnectedCoreBrush" Center="0.5,0.42" GradientOrigin="0.5,0.34" RadiusX="0.68" RadiusY="0.68">
        <GradientStop Color="#FF1F5E7A" Offset="0" />
        <GradientStop Color="#FF153A63" Offset="0.6" />
        <GradientStop Color="#FF0C1B3C" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="OrbConnectedGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#7A4FE3FF" Offset="0" />
        <GradientStop Color="#2EA855F7" Offset="0.55" />
        <GradientStop Color="#00A855F7" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="OrbPulseBrush" Color="#804FE3FF" />
    <!--#endregion-->

    <!--#region 圆角与间距 -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CardControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="SidebarCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="SidebarItemCornerRadius">15</CornerRadius>

    <!-- 左边 156 = 悬浮侧栏 124 + 常规留白 32：
         侧栏是浮在页面之上的，页面必须自己让开，这样页面宽度才等于窗口宽度，
         首页的星号比例才能精确对应窗口比例。 -->
    <Thickness x:Key="PagePadding">156,22,32,26</Thickness>
    <!-- 引导页（隐私协议 / 登录）专用：此时悬浮侧栏是隐藏的，
         不能沿用 PagePadding 的 156 左边距，否则整体偏右、与右侧图片挤在一起。 -->
    <Thickness x:Key="OnboardingPadding">56,34,32,32</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>
    <!--#endregion-->

</ResourceDictionary>
