<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮侧栏中的一个导航项：图标 + 文字，支持悬停高亮与选中态。
    选中态的背景「指示块」由 MainWindow 统一绘制并做位移动画，本控件只负责前景配色。
-->
<UserControl
    x:Class="RayShuttle.Controls.SidebarItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot"
          Width="60"
          Height="58"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          RenderTransformOrigin="0.5,0.5"
          Tapped="OnTapped">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>

        <Border x:Name="HoverFill"
                Background="{StaticResource SidebarHoverBrush}"
                CornerRadius="{StaticResource SidebarItemCornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Spacing="4">
            <FontIcon x:Name="ItemIcon"
                      FontSize="16"
                      Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="ItemLabel"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
