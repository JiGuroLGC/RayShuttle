<?xml version="1.0" encoding="utf-8"?>
<!--
    连接光球：应用的核心交互控件。
    由外到内依次为 —— 光晕 / 反向旋转细环 / 主旋转光环 / 脉冲扩散环 / 实心核心。
    三种状态（未连接、连接中、已连接）由 State 依赖属性驱动，动画在代码后置中控制。
    整体尺寸 272，与 MainWindow 的最小窗口尺寸配套，保证小屏也能完整显示。
-->
<UserControl
    x:Class="RayShuttle.Controls.ConnectOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot"
          Width="272"
          Height="272"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          RenderTransformOrigin="0.5,0.5"
          Tapped="OnTapped">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>

        <!-- 外光晕 -->
        <Ellipse x:Name="Glow"
                 Width="272"
                 Height="272"
                 Fill="{StaticResource OrbIdleGlowBrush}"
                 IsHitTestVisible="False" />

        <!-- 反向旋转的细刻度环，增加科技感 -->
        <Ellipse x:Name="RingTicks"
                 Width="250"
                 Height="250"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="#33A7F0FF"
                 StrokeDashArray="0.4,7"
                 StrokeThickness="1.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingTicksRotation" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 主旋转光环 -->
        <Ellipse x:Name="RingOuter"
                 Width="224"
                 Height="224"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="{StaticResource OrbActiveRingBrush}"
                 StrokeDashArray="0.9,2.6"
                 StrokeThickness="2.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingOuterRotation" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 脉冲扩散环 -->
        <Ellipse x:Name="Pulse1"
                 Width="176"
                 Height="176"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="{StaticResource OrbPulseBrush}"
                 StrokeThickness="1.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Pulse2"
                 Width="176"
                 Height="176"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="{StaticResource OrbPulseBrush}"
                 StrokeThickness="1.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale2" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 核心圆盘 -->
        <Border x:Name="Core"
                Width="154"
                Height="154"
                Background="{StaticResource OrbIdleCoreBrush}"
                BorderBrush="{StaticResource OrbIdleStrokeBrush}"
                BorderThickness="1.5"
                CornerRadius="999"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CoreScale" />
            </Border.RenderTransform>

            <Grid>
                <!-- 内衬高光，制造玻璃球面质感 -->
                <Ellipse Width="154"
                         Height="154"
                         Fill="{StaticResource TopSheenBrush}"
                         Opacity="0.35" />
                <Ellipse Width="132"
                         Height="132"
                         Opacity="0.5"
                         Stroke="#1FFFFFFF"
                         StrokeThickness="1" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <FontIcon x:Name="CoreIcon"
                              FontSize="30"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Glyph="&#xE7E8;" />
                    <TextBlock x:Name="CoreLabel"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="连接" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
